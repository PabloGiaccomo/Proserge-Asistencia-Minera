<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_copiar_servicio_transporte" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_logistica_operativa_copiar_servicio_transporte" name="Copiar servicio de transporte" isExecutable="false">
    <bpmn:documentation>Crea un nuevo BORRADOR desde otro servicio, con fecha y turno elegidos; copia placa y conductor solo si se solicita. | Evidencia: app/Modules/Transporte/Services/TransportePlanningService.php; app/Models/TransporteServicio.php</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_copiar_servicio_transporte">
    <bpmn:lane id="Lane_User" name="Usuario autorizado / Logistica">
      <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Permission</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Build</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Servicio existente">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Elegir fecha, turno y opciones de copia">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio: copiar_placa y copiar_conductor son opcionales.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Permission" name="Validar permiso crear, duplicar o administrar">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio: TRANSPORTE_COPY_FORBIDDEN.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Build" name="Preparar BORRADOR y alcances compatibles">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio: copyableGrupoTrabajoId limita grupo a nueva fecha y turno; no copia pasajeros.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Create" name="Crear nuevo servicio con validaciones">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio delega en createServicio, que vuelve a exigir crear/administrar y valida datos antes de guardar.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Creacion aceptada?">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::createServicio puede retornar error de permiso/validacion.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Done" name="Copia BORRADOR creada">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio; identidad nueva y evento CREACION.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Reject" name="Copia rechazada">
      <bpmn:documentation>app/Modules/Transporte/Services/TransportePlanningService.php::copyServicio/createServicio no crea nuevo servicio cuando falla permiso o validacion.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Select"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Select" targetRef="Permission"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Permission" targetRef="Build"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Build" targetRef="Create"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Create" targetRef="Valid"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Valid" targetRef="Done" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Valid" targetRef="Reject" name="No"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_copiar_servicio_transporte">
    <bpmndi:BPMNPlane id="Plane_copiar_servicio_transporte" bpmnElement="Process_logistica_operativa_copiar_servicio_transporte">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="370" width="1470" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Select_di" bpmnElement="Select">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Permission_di" bpmnElement="Permission">
        <dc:Bounds x="595" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Build_di" bpmnElement="Build">
        <dc:Bounds x="785" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Create_di" bpmnElement="Create">
        <dc:Bounds x="975" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid">
        <dc:Bounds x="1165" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="1355" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="460" />
        <di:waypoint x="595" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="460" />
        <di:waypoint x="765" y="460" />
        <di:waypoint x="765" y="460" />
        <di:waypoint x="785" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="935" y="460" />
        <di:waypoint x="955" y="460" />
        <di:waypoint x="955" y="460" />
        <di:waypoint x="975" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1125" y="460" />
        <di:waypoint x="1145" y="460" />
        <di:waypoint x="1145" y="460" />
        <di:waypoint x="1165" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1215" y="460" />
        <di:waypoint x="1285" y="460" />
        <di:waypoint x="1285" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1215" y="460" />
        <di:waypoint x="1285" y="460" />
        <di:waypoint x="1285" y="280" />
        <di:waypoint x="1355" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
