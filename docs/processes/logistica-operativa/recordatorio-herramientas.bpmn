<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_recordatorio_herramientas" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_logistica_operativa_recordatorio_herramientas" name="Recordar vencimiento de herramientas" isExecutable="false">
    <bpmn:documentation>Comprobar tablas; si faltan devolver cero. Seleccionar RQ con inicio en nueve dias y lista no enviada. Por RQ: emitir solo si limite vence en dos dias. Emitir a jefes de planeamiento con clave de deduplicacion. Informar alertas emitidas; devolver SUCCESS | Evidencia: routes/console.php; app/Console/Commands/ParadaHerramientasDeadlineReminderCommand.php::handle; app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_recordatorio_herramientas">
    <bpmn:lane id="Lane_Auto" name="Proceso automatico / Sistema">
      <bpmn:flowNodeRef>Start_Timer</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Run</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Timer" name="30 7 * * *">
      <bpmn:documentation>routes/console.php. Expresion del scheduler Laravel; diagrama descriptivo no ejecutable. Zona horaria efectiva depende de configuracion y despliegue.</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Start_Timer_timer"><bpmn:timeCycle>30 7 * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_0" name="Comprobar tablas; si faltan devolver cero">
      <bpmn:documentation>app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders: notification_types y parada_herramienta_listas.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_1" name="Seleccionar RQ con inicio en nueve dias y lista no enviada">
      <bpmn:documentation>app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders: lista ausente o estado distinto de ENVIADO.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_2" name="Por RQ: emitir solo si limite vence en dos dias">
      <bpmn:documentation>app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders: fecha_limite_envio o deadlineFor; si no coincide omite el RQ.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_3" name="Emitir a jefes de planeamiento con clave de deduplicacion">
      <bpmn:documentation>app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders: tipo lista_herramientas_por_vencer, actor null, clave RQ+fecha. No envia ni modifica la lista.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_4" name="Informar alertas emitidas; devolver SUCCESS">
      <bpmn:documentation>ParadaHerramientasDeadlineReminderCommand::handle. No captura localmente excepciones del servicio: se propagan, sin garantizar rollback global.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Run" name="Ejecucion finalizada; consultar resumen">
      <bpmn:documentation>app/Console/Commands/ParadaHerramientasDeadlineReminderCommand.php::handle; app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php::emitDeadlineReminders</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Timer" targetRef="Task_0"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_0" targetRef="Task_1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="End_Run"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_recordatorio_herramientas">
    <bpmndi:BPMNPlane id="Plane_recordatorio_herramientas" bpmnElement="Process_logistica_operativa_recordatorio_herramientas">
      <bpmndi:BPMNShape id="Lane_Auto_di" bpmnElement="Lane_Auto" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Timer_di" bpmnElement="Start_Timer">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_0_di" bpmnElement="Task_0">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="595" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="785" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="975" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="1165" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Run_di" bpmnElement="End_Run">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="595" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="160" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="785" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="935" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1125" y="160" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1315" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
