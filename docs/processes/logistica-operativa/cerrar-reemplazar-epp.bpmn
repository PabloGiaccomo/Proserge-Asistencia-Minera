<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_cerrar-reemplazar-epp" targetNamespace="https://proserge.com/bpmn">
<bpmn:process id="Process" name="Corregir o anular operacion EPP firmada" isExecutable="false">
<bpmn:laneSet id="Lanes">
<bpmn:lane id="Lane_Usuario" name="Usuario"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Sistema" name="Sistema"><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Save</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Seleccionar operacion firmada"><bpmn:documentation>EppOperationPageController::show</bpmn:documentation><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="Request" name="Elegir correccion/anulacion, cantidades y motivo"><bpmn:documentation>CorrectEppOperationRequest; AnnulEppOperationRequest</bpmn:documentation><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask>
<bpmn:businessRuleTask id="Check" name="Validar permiso, alcance y efecto reversible"><bpmn:documentation>EppCorrectionService::compensate; policy correct/cancel; lockForUpdate</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Valid" name="Efecto compensable vigente?"><bpmn:documentation>EppCorrectionService::remainingReversibleQuantity</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Save" name="Crear compensacion y movimientos enlazados"><bpmn:documentation>EppCorrectionService::reverseDelivery/reverseReturn; conserva operacion y firma originales</bpmn:documentation><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="Done" name="Compensacion registrada con trazabilidad"><bpmn:documentation>EppOperacion::operacionesCompensatorias; original inmutable</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="Reject" name="Rechazo sin cambios"><bpmn:documentation>EppCorrectionService::compensate; excepcion y rollback</bpmn:documentation><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Request"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Request" targetRef="Check"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Valid"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="Valid" targetRef="Save" name="Si"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Valid" targetRef="Reject" name="No"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Save" targetRef="Done"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
<bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="90" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Request" bpmnElement="Request"><dc:Bounds x="310" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check"><dc:Bounds x="530" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Valid" bpmnElement="Valid"><dc:Bounds x="750" y="100" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Save" bpmnElement="Save"><dc:Bounds x="970" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Done" bpmnElement="Done"><dc:Bounds x="90" y="280" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Reject"><dc:Bounds x="310" y="280" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="126" y="118"/><di:waypoint x="310" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="490" y="140"/><di:waypoint x="530" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="710" y="140"/><di:waypoint x="750" y="125"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="800" y="125"/><di:waypoint x="970" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="800" y="125"/><di:waypoint x="310" y="298"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="1150" y="140"/><di:waypoint x="90" y="298"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
