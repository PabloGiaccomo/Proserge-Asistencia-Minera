<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_entrega_devolucion_epp" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_logistica_operativa_entrega_devolucion_epp" name="Registrar entrega de EPP" isExecutable="false">
    <bpmn:documentation>Entrega independiente; cierre y reemplazo se documentan en un proceso separado. | Evidencia: app/Modules/Epps/Services/EppService.php; app/Modules/Epps/Controllers/EppPageController.php; routes/web.php</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_entrega_devolucion_epp">
    <bpmn:lane id="Lane_User" name="Usuario autorizado / Logistica">
      <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Solicitar entrega">
      <bpmn:documentation>app/Modules/Epps/Controllers/EppPageController.php::storeEntrega</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Elegir trabajador, EPP, fecha y cantidad">
      <bpmn:documentation>app/Modules/Epps/Controllers/EppPageController.php::storeEntrega; ultimaEntrega muestra historial sin constituir una condicion para guardar.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Validate" name="Validar permiso y formulario">
      <bpmn:documentation>routes/web.php: web.permission:epps,registrar; app/Modules/Epps/Controllers/EppPageController.php::storeEntrega valida referencias y datos.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid" name="Datos validos?">
      <bpmn:documentation>app/Modules/Epps/Controllers/EppPageController.php::storeEntrega; validacion previa a deliver.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Save" name="Crear ENTREGADO con snapshot">
      <bpmn:documentation>app/Modules/Epps/Services/EppService.php::deliver: transaccion, vida util, vencimiento calendario, atributos y registrado_por_usuario_id.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Entrega registrada">
      <bpmn:documentation>app/Modules/Epps/Services/EppService.php::deliver. No exige una devolucion posterior en esta solicitud.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Reject" name="Rechazo sin entrega">
      <bpmn:documentation>app/Modules/Epps/Controllers/EppPageController.php::storeEntrega; middleware o validacion impiden crear.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Select"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Select" targetRef="Validate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Validate" targetRef="Valid"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Valid" targetRef="Save" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Save" targetRef="Done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Valid" targetRef="Reject" name="No"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_entrega_devolucion_epp">
    <bpmndi:BPMNPlane id="Plane_entrega_devolucion_epp" bpmnElement="Process_logistica_operativa_entrega_devolucion_epp">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1310" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="250" width="1310" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Select_di" bpmnElement="Select">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate">
        <dc:Bounds x="595" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid">
        <dc:Bounds x="785" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Save_di" bpmnElement="Save">
        <dc:Bounds x="975" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1165" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="975" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="595" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="785" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="835" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="975" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1125" y="340" />
        <di:waypoint x="1145" y="340" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="835" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="905" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
