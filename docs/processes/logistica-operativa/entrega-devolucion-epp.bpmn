<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_entrega-devolucion-epp" targetNamespace="https://proserge.com/bpmn">
<bpmn:process id="Process" name="Entrega o devolucion multiple con firma" isExecutable="false">
<bpmn:laneSet id="Lanes">
<bpmn:lane id="Lane_Usuario" name="Usuario"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Sign</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Sistema" name="Sistema"><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Available</bpmn:flowNodeRef><bpmn:flowNodeRef>Save</bpmn:flowNodeRef><bpmn:flowNodeRef>NoStock</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Solicitar lote"><bpmn:documentation>EppOperationPageController::create/createReturn</bpmn:documentation><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="Prepare" name="Elegir trabajador, almacen y lineas"><bpmn:documentation>EppOperationPageController::store/storeReturn; StoreEppOperationRequest/StoreEppReturnRequest</bpmn:documentation><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:userTask>
<bpmn:businessRuleTask id="Check" name="Validar permiso, alcance, stock o saldo"><bpmn:documentation>EppOperationPolicy; EppScopeService; EppOperationService::prepareForSignature</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Available" name="Hay unidades procesables?"><bpmn:documentation>EppOperationService::prepareForSignature</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Review" name="Revisar unidades procesadas y pendientes"><bpmn:documentation>EppOperationService::reviewPayload; operations/review.blade.php</bpmn:documentation><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Accept" name="Trabajador acepta el resumen?"><bpmn:documentation>EppOperationPageController::sign/reject</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Sign" name="Firmar trabajador o testigo autorizado"><bpmn:documentation>SignEppOperationRequest; EppAcceptanceService::signerContext; negativa no admite testigo</bpmn:documentation><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Save" name="Confirmar firma, inventario y saldo atomico"><bpmn:documentation>EppOperationConfirmationService::confirm/confirmWithWitness; reintento idempotente por UUID; errores revierten transaccion</bpmn:documentation><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="Done" name="FIRMADO o FIRMADO_PARCIAL"><bpmn:documentation>EppOperationConfirmationService; EppEvidenceController::receipt/verify</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="NoStock" name="PENDIENTE_STOCK sin entrega"><bpmn:documentation>EppOperationService::prepareForSignature</bpmn:documentation><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Reject" name="Rechazar y liberar reservas"><bpmn:documentation>EppOperationService::reject; no genera entrega ni aceptacion</bpmn:documentation><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="Rejected" name="RECHAZADO sin movimiento"><bpmn:documentation>EppOperationService::reject</bpmn:documentation><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Prepare"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Prepare" targetRef="Check"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Available"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="Available" targetRef="Review" name="Si"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Available" targetRef="NoStock" name="No"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Review" targetRef="Accept"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Accept" targetRef="Sign" name="Si"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Accept" targetRef="Reject" name="Desacuerdo o negativa"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Sign" targetRef="Save"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Save" targetRef="Done"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Reject" targetRef="Rejected"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process">
<bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="90" y="100" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Prepare" bpmnElement="Prepare"><dc:Bounds x="310" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check"><dc:Bounds x="530" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Available" bpmnElement="Available"><dc:Bounds x="750" y="100" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review"><dc:Bounds x="970" y="100" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Accept" bpmnElement="Accept"><dc:Bounds x="90" y="280" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Sign" bpmnElement="Sign"><dc:Bounds x="310" y="280" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Save" bpmnElement="Save"><dc:Bounds x="530" y="280" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Done" bpmnElement="Done"><dc:Bounds x="750" y="280" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_NoStock" bpmnElement="NoStock"><dc:Bounds x="970" y="280" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Reject"><dc:Bounds x="90" y="460" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected"><dc:Bounds x="310" y="460" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="126" y="118"/><di:waypoint x="310" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="490" y="140"/><di:waypoint x="530" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="710" y="140"/><di:waypoint x="750" y="125"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="800" y="125"/><di:waypoint x="970" y="140"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="800" y="125"/><di:waypoint x="970" y="298"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="1150" y="140"/><di:waypoint x="90" y="305"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="140" y="305"/><di:waypoint x="310" y="320"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="140" y="305"/><di:waypoint x="90" y="500"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="490" y="320"/><di:waypoint x="530" y="320"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="710" y="320"/><di:waypoint x="750" y="298"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="270" y="500"/><di:waypoint x="310" y="478"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
