<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_herramientas_por_parada" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_logistica_operativa_herramientas_por_parada" name="Lista de herramientas por parada" isExecutable="false">
    <bpmn:documentation>Preparar y enviar lista de herramientas. Los recordatorios se ejecutan independientemente por scheduler. | Evidencia: app/Modules/ParadaHerramientas/Services/ParadaHerramientaService.php; app/Console/Commands/ParadaHerramientasDeadlineReminderCommand.php; tests/Feature/ParadaHerramientaServiceTest.php | Por confirmar: Quien valida el contenido final y que estado representa el cierre.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_herramientas_por_parada">
    <bpmn:lane id="Lane_Supervisor" name="Supervisor/Logistica">
      <bpmn:flowNodeRef>Start_Tools</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Edit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Send</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Sent</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Ensure</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Tools" name="Parada requiere herramientas">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Ensure" name="Crear o recuperar lista">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Edit" name="Completar grupos, items y cantidades">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Save" name="Guardar lista y pedidos">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Send" name="Enviar lista">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Sent" name="Lista enviada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Tools" targetRef="Task_Ensure"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Ensure" targetRef="Task_Edit"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Edit" targetRef="Task_Save"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Save" targetRef="Task_Send"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Send" targetRef="End_Sent"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_herramientas_por_parada">
    <bpmndi:BPMNPlane id="Plane_herramientas_por_parada" bpmnElement="Process_logistica_operativa_herramientas_por_parada">
      <bpmndi:BPMNShape id="Lane_Supervisor_di" bpmnElement="Lane_Supervisor" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="250" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Tools_di" bpmnElement="Start_Tools">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ensure_di" bpmnElement="Task_Ensure">
        <dc:Bounds x="405" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Edit_di" bpmnElement="Task_Edit">
        <dc:Bounds x="595" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Save_di" bpmnElement="Task_Save">
        <dc:Bounds x="785" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Send_di" bpmnElement="Task_Send">
        <dc:Bounds x="1165" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Sent_di" bpmnElement="End_Sent">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="340" />
        <di:waypoint x="405" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="340" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="595" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="745" y="160" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="785" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="935" y="340" />
        <di:waypoint x="1050" y="340" />
        <di:waypoint x="1050" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1315" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
