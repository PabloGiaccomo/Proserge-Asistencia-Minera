<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_anular_bloqueo" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_bienestar_anular_bloqueo" name="Anular bloqueo de bienestar" isExecutable="false">
    <bpmn:documentation>Cambia el estado del bloqueo existente a ANULADO y solicita notificacion. | Evidencia: routes/web.php; app/Modules/Bienestar/Controllers/BienestarPageController.php; app/Modules/Notificaciones/Services/OperationalNotificationService.php</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_anular_bloqueo">
    <bpmn:lane id="Lane_User" name="Bienestar/RR.HH. autorizado">
      <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Se solicita anulacion">
      <bpmn:documentation>routes/web.php: POST /bienestar/bloqueos/{bloqueoId}/anular.</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Request" name="Confirmar anulacion">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php::anularBloqueo</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Validate" name="Validar permiso y existencia">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php::anularBloqueo: permiso eliminar/anular; findOrFail.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Allowed" name="Puede anular?">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php::anularBloqueo</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Save" name="Cambiar estado a ANULADO">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php::anularBloqueo: update estado=ANULADO; no valida estado previo.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Notify" name="Solicitar notificacion">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php: bienestarBloqueoAnulado solo si usuario de sesion existe.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Bloqueo anulado">
      <bpmn:documentation>app/Modules/Bienestar/Controllers/BienestarPageController.php: vuelve a pantalla anterior.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Reject" name="Anulacion rechazada">
      <bpmn:documentation>Permiso denegado o bloqueo no encontrado.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Request"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Request" targetRef="Validate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Validate" targetRef="Allowed"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Allowed" targetRef="Save" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Allowed" targetRef="Reject" name="No"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Save" targetRef="Notify"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Notify" targetRef="Done"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_anular_bloqueo">
    <bpmndi:BPMNPlane id="Plane_anular_bloqueo" bpmnElement="Process_bienestar_anular_bloqueo">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="250" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Request_di" bpmnElement="Request">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate">
        <dc:Bounds x="595" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Allowed_di" bpmnElement="Allowed">
        <dc:Bounds x="785" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Save_di" bpmnElement="Save">
        <dc:Bounds x="975" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify">
        <dc:Bounds x="1165" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="975" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="595" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="785" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="835" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="975" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="835" y="340" />
        <di:waypoint x="905" y="340" />
        <di:waypoint x="905" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1125" y="340" />
        <di:waypoint x="1145" y="340" />
        <di:waypoint x="1145" y="340" />
        <di:waypoint x="1165" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1315" y="340" />
        <di:waypoint x="1335" y="340" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
