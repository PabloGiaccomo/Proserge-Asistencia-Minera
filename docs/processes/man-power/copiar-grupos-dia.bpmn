        <di:waypoint x="1355" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1505" y="460" />
        <di:waypoint x="1525" y="460" />
        <di:waypoint x="1525" y="160" />
        <di:waypoint x="1545" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
