<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_agregar_integrante" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_man_power_agregar_integrante" name="Agregar integrante a grupo de Man Power" isExecutable="false">
    <bpmn:documentation>Agrega una asignacion aprobada para la parada cuando no hay asistencia iniciada ni conflicto de distribucion. | Evidencia: app/Modules/ManPower/Services/GrupoTrabajoService.php; app/Modules/ManPower/Policies/ManPowerPolicy.php; routes/web.php; routes/api.php</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_agregar_integrante">
    <bpmn:lane id="Lane_User" name="Planificador operativo">
      <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Candidate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Grupo existente">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Elegir persona o asignacion RQ Proserge">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Check" name="Validar permiso y asistencia">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal: man_power.asignar, manageGrupo; bloquea si la mina/fecha tiene asistencia iniciada o el grupo tiene asistencia cerrada.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Candidate" name="Validar universo aprobado y conflicto">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::resolveSingleAssignment: debe corresponder a RQ Proserge; hasDistributionConflict verifica fecha y turno.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid" name="Asignacion permitida?">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal retorna error de negocio si no cumple.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Save" name="Agregar asignacion al grupo">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addAssignmentToGrupo guarda detalle y snapshots.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Integrante agregado">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal devuelve grupo.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Reject" name="Sin cambio">
      <bpmn:documentation>app/Modules/ManPower/Services/GrupoTrabajoService.php::addPersonal retorna error por permiso, asistencia o conflicto.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Select"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Select" targetRef="Check"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Candidate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Candidate" targetRef="Valid"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Valid" targetRef="Save" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Save" targetRef="Done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Valid" targetRef="Reject" name="No"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_agregar_integrante">
    <bpmndi:BPMNPlane id="Plane_agregar_integrante" bpmnElement="Process_man_power_agregar_integrante">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="250" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Select_di" bpmnElement="Select">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="595" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Candidate_di" bpmnElement="Candidate">
        <dc:Bounds x="785" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid">
        <dc:Bounds x="975" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Save_di" bpmnElement="Save">
        <dc:Bounds x="1165" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="1165" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="595" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="785" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="935" y="340" />
        <di:waypoint x="955" y="340" />
        <di:waypoint x="955" y="340" />
        <di:waypoint x="975" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1025" y="340" />
        <di:waypoint x="1095" y="340" />
        <di:waypoint x="1095" y="340" />
        <di:waypoint x="1165" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1315" y="340" />
        <di:waypoint x="1335" y="340" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1025" y="340" />
        <di:waypoint x="1095" y="340" />
        <di:waypoint x="1095" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
