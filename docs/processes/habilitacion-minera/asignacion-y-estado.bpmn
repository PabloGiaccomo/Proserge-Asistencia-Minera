<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_asignacion_y_estado" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_habilitacion_minera_asignacion_y_estado" name="Asignar trabajador y calcular habilitacion" isExecutable="false">
    <bpmn:documentation>Asignar mina, generar requisitos y calcular HABILITADO, EN_PROCESO, OBSERVADO o NO_HABILITADO, sin cambiar el estado laboral. | Evidencia: app/Modules/Personal/Services/PersonalMinaHabilitacionService.php; app/Models/PersonalMina.php; tests/Feature/PersonalMinaHabilitacionBaseTest.php; tests/Feature/PersonalMinaHabilitacionCorrectedFlowTest.php</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_asignacion_y_estado">
    <bpmn:lane id="Lane_User" name="Usuario autorizado">
      <bpmn:flowNodeRef>Start_Assign</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Enabled</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_OBSERVADO</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_NO_HABILITADO</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Permission</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Generate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Calculate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Resolved</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Assign" name="Selecciona trabajador y mina">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Permission" name="Validar permiso, scope y trabajador">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_Assign" name="Crear/reactivar PersonalMina">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Generate" name="Generar examenes requeridos">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Calculate" name="Calcular estado por requisitos">
      <bpmn:documentation>PersonalMinaHabilitacionService::calculateAssignmentStatus: configuracion o examenes vacios -&gt; EN_PROCESO; sin obligatorios -&gt; HABILITADO; faltantes -&gt; EN_PROCESO; observado -&gt; OBSERVADO; desaprobado sin intentos disponibles -&gt; NO_HABILITADO; vencidos -&gt; EN_PROCESO; obligatorios resueltos -&gt; HABILITADO.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Resolved" name="Estado calculado">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_OBSERVADO</bpmn:outgoing>
      <bpmn:outgoing>Flow_NO_HABILITADO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Enabled" name="HABILITADO">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Process" name="EN_PROCESO">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OBSERVADO" name="OBSERVADO">
      <bpmn:incoming>Flow_OBSERVADO</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NO_HABILITADO" name="NO_HABILITADO">
      <bpmn:incoming>Flow_NO_HABILITADO</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Assign" targetRef="Task_Permission"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Permission" targetRef="Task_Assign"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Assign" targetRef="Task_Generate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Generate" targetRef="Task_Calculate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Calculate" targetRef="Gateway_Resolved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Resolved" targetRef="End_Enabled" name="HABILITADO"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Resolved" targetRef="End_Process" name="EN_PROCESO"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OBSERVADO" sourceRef="Gateway_Resolved" targetRef="End_OBSERVADO" name="OBSERVADO"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NO_HABILITADO" sourceRef="Gateway_Resolved" targetRef="End_NO_HABILITADO" name="NO_HABILITADO"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_asignacion_y_estado">
    <bpmndi:BPMNPlane id="Plane_asignacion_y_estado" bpmnElement="Process_habilitacion_minera_asignacion_y_estado">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="610" width="1470" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Assign_di" bpmnElement="Start_Assign">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Permission_di" bpmnElement="Task_Permission">
        <dc:Bounds x="405" y="664" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Assign_di" bpmnElement="Task_Assign">
        <dc:Bounds x="595" y="664" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Generate_di" bpmnElement="Task_Generate">
        <dc:Bounds x="785" y="664" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Calculate_di" bpmnElement="Task_Calculate">
        <dc:Bounds x="975" y="664" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Resolved_di" bpmnElement="Gateway_Resolved">
        <dc:Bounds x="1165" y="675" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Enabled_di" bpmnElement="End_Enabled">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Process_di" bpmnElement="End_Process">
        <dc:Bounds x="1355" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OBSERVADO_di" bpmnElement="End_OBSERVADO">
        <dc:Bounds x="1355" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NO_HABILITADO_di" bpmnElement="End_NO_HABILITADO">
        <dc:Bounds x="1355" y="502" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="700" />
        <di:waypoint x="405" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="700" />
        <di:waypoint x="575" y="700" />
        <di:waypoint x="575" y="700" />
        <di:waypoint x="595" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="745" y="700" />
        <di:waypoint x="765" y="700" />
        <di:waypoint x="765" y="700" />
        <di:waypoint x="785" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="935" y="700" />
        <di:waypoint x="955" y="700" />
        <di:waypoint x="955" y="700" />
        <di:waypoint x="975" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1125" y="700" />
        <di:waypoint x="1145" y="700" />
        <di:waypoint x="1145" y="700" />
        <di:waypoint x="1165" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1215" y="700" />
        <di:waypoint x="1285" y="700" />
        <di:waypoint x="1285" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1215" y="700" />
        <di:waypoint x="1285" y="700" />
        <di:waypoint x="1285" y="280" />
        <di:waypoint x="1355" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OBSERVADO_di" bpmnElement="Flow_OBSERVADO">
        <di:waypoint x="1215" y="700" />
        <di:waypoint x="1285" y="700" />
        <di:waypoint x="1285" y="400" />
        <di:waypoint x="1355" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NO_HABILITADO_di" bpmnElement="Flow_NO_HABILITADO">
        <di:waypoint x="1215" y="700" />
        <di:waypoint x="1285" y="700" />
        <di:waypoint x="1285" y="520" />
        <di:waypoint x="1355" y="520" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
