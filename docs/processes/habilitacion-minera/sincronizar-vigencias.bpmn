<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_sincronizar_vigencias" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_habilitacion_minera_sincronizar_vigencias" name="Sincronizar vigencias mineras" isExecutable="false">
    <bpmn:documentation>Cargar requisitos activos y asignaciones de minas operativas. Por asignacion: transaccion, bloqueo y recalculo temporal. Guardar estado e historial solo si cambia la asignacion. Capturar error por asignacion y continuar con las restantes. Informar contadores; FAILURE si errores mayor que cero | Evidencia: routes/console.php; app/Console/Commands/HabilitacionMineraSyncTemporalStatusesCommand.php::handle; app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_sincronizar_vigencias">
    <bpmn:lane id="Lane_Auto" name="Proceso automatico / Sistema">
      <bpmn:flowNodeRef>Start_Timer</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Run</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Timer" name="10 0 * * *">
      <bpmn:documentation>routes/console.php. Expresion del scheduler Laravel; diagrama descriptivo no ejecutable. Zona horaria efectiva depende de configuracion y despliegue.</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Start_Timer_timer"><bpmn:timeCycle>10 0 * * *</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_0" name="Cargar requisitos activos y asignaciones de minas operativas">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses: PersonalMina activo, mina activeOperational; lotes de 100; scheduler withoutOverlapping.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_1" name="Por asignacion: transaccion, bloqueo y recalculo temporal">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses: si desaparecio omite; calculateAssignmentStatus actualiza vigencias de examenes y calcula estado.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_2" name="Guardar estado e historial solo si cambia la asignacion">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses: estado, estado_habilitacion y fecha_habilitacion; recordHistory con actor null. Sin cambio de asignacion conserva actualizaciones de examenes.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_3" name="Capturar error por asignacion y continuar con las restantes">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses: Throwable revierte transaccion de esa asignacion, report(error), errores++. No hay transaccion global del lote.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_4" name="Informar contadores; FAILURE si errores mayor que cero">
      <bpmn:documentation>HabilitacionMineraSyncTemporalStatusesCommand::handle. Los contadores no sustituyen una auditoria de filas confirmadas.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Run" name="Ejecucion finalizada; consultar resumen">
      <bpmn:documentation>app/Console/Commands/HabilitacionMineraSyncTemporalStatusesCommand.php::handle; app/Modules/Personal/Services/PersonalMinaHabilitacionService.php::syncTemporalStatuses</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_Timer" targetRef="Task_0"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_0" targetRef="Task_1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="End_Run"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_sincronizar_vigencias">
    <bpmndi:BPMNPlane id="Plane_sincronizar_vigencias" bpmnElement="Process_habilitacion_minera_sincronizar_vigencias">
      <bpmndi:BPMNShape id="Lane_Auto_di" bpmnElement="Lane_Auto" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Timer_di" bpmnElement="Start_Timer">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_0_di" bpmnElement="Task_0">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="595" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="785" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="975" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="1165" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Run_di" bpmnElement="End_Run">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="595" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="745" y="160" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="785" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="935" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1125" y="160" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1315" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
