<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_importacion_master_minero" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_habilitacion_minera_importacion_master_minero" name="Importacion de master minero" isExecutable="false">
    <bpmn:documentation>Previsualiza y confirma configuracion/asignaciones de trabajadores existentes sin sobrescribir datos laborales sensibles. | Evidencia: app/Modules/Personal/Services/PersonalMinaExcelImportService.php; app/Modules/Personal/Controllers/PersonalMinaHabilitacionController.php; docs/BUSINESS_RULES_RRHH.md | Por confirmar: Autoridad operativa del master frente a discrepancias de estados historicos.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_importacion_master_minero">
    <bpmn:lane id="Lane_User" name="Usuario autorizado">
      <bpmn:flowNodeRef>Start_Master</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Preview</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Confirm</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Summary</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Cancel</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Parse</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Compare</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Apply</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Master" name="Carga master Excel">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Parse" name="Leer hojas, columnas y datos">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Compare" name="Cruzar trabajadores, minas y examenes">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_Preview" name="Revisar creados, cambios y no mapeados">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Confirm" name="Confirmar importacion?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Apply" name="Aplicar configuracion permitida">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Summary" name="Resumen de importacion">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancel" name="Sin cambios">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Master" targetRef="Task_Parse"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Parse" targetRef="Task_Compare"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Compare" targetRef="Task_Preview"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Preview" targetRef="Gateway_Confirm"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Confirm" targetRef="Task_Apply" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Apply" targetRef="End_Summary"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Confirm" targetRef="End_Cancel" name="No"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_importacion_master_minero">
    <bpmndi:BPMNPlane id="Plane_importacion_master_minero" bpmnElement="Process_habilitacion_minera_importacion_master_minero">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="250" width="1470" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Master_di" bpmnElement="Start_Master">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Parse_di" bpmnElement="Task_Parse">
        <dc:Bounds x="405" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compare_di" bpmnElement="Task_Compare">
        <dc:Bounds x="595" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Preview_di" bpmnElement="Task_Preview">
        <dc:Bounds x="785" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Confirm_di" bpmnElement="Gateway_Confirm">
        <dc:Bounds x="975" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Apply_di" bpmnElement="Task_Apply">
        <dc:Bounds x="1165" y="304" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Summary_di" bpmnElement="End_Summary">
        <dc:Bounds x="1355" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancel_di" bpmnElement="End_Cancel">
        <dc:Bounds x="1165" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="340" />
        <di:waypoint x="405" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="340" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="595" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="745" y="340" />
        <di:waypoint x="765" y="340" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="785" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="935" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="955" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1025" y="160" />
        <di:waypoint x="1095" y="160" />
        <di:waypoint x="1095" y="340" />
        <di:waypoint x="1165" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1315" y="340" />
        <di:waypoint x="1335" y="340" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1025" y="160" />
        <di:waypoint x="1095" y="160" />
        <di:waypoint x="1095" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
