<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ficha_temporal_revision" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_personal_ficha_temporal_revision" name="Completar y revisar ficha temporal" isExecutable="false">
    <bpmn:documentation>El trabajador abre un enlace ya activo, completa la ficha y RR.HH. aprueba u observa. Activar y enviar el enlace son operaciones anteriores independientes. | Evidencia: routes/web.php; app/Modules/Personal/Services/PersonalFichaService.php; app/Modules/Personal/Controllers/PublicPersonalFichaController.php; app/Modules/Personal/Controllers/PersonalFichaController.php; tests/Feature/PersonalFichaObservedResubmitTest.php; tests/Feature/PersonalFichaApproveContractDatesTest.php | Por confirmar: Campos que RR.HH. puede editar despues de la aprobacion.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ficha_temporal_revision">
    <bpmn:lane id="Lane_RRHH" name="RR.HH.">
      <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Result</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Contract</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_Worker" name="Trabajador">
      <bpmn:flowNodeRef>Start_Create</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_LinkUnavailable</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Link</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Observe</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Token</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Create" name="Trabajador abre enlace temporal">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::resolveToken</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Link" name="Resolver token, vigencia y modo">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::resolveToken: invalid, disabled, expired, readonly o edit; registra acceso. No envia correo en esta solicitud.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Submit" name="Completar y enviar ficha">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_TokenYes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_Validate" name="Validar campos y documentos">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_Review" name="Revisar ficha enviada">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Result" name="Resultado de revision">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Observe" name="Marcar OBSERVADO y notificar">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::observe: transaccion, marca OBSERVADO; el trabajador puede corregir si su enlace lo permite.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Approve" name="APROBADO -&gt; FALTA_CONTRATO">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::approve: transaccion, normaliza fechas, actualiza Personal a pendiente contractual, marca ficha APROBADO e inhabilita link; notificacion posterior.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Contract" name="Lista para contrato">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Token" name="Link permite editar?">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::resolveToken: solo mode edit permite continuar el formulario.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_TokenYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_TokenNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LinkUnavailable" name="Link invalido, vencido o solo lectura">
      <bpmn:documentation>app/Modules/Personal/Services/PersonalFichaService.php::resolveToken; puede actualizar estado a expirado o inhabilitado.</bpmn:documentation>
      <bpmn:incoming>Flow_TokenNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Create" targetRef="Task_Link"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Link" targetRef="Gateway_Token"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Submit" targetRef="Task_Validate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Validate" targetRef="Task_Review"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Review" targetRef="Gateway_Result"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Result" targetRef="Task_Approve" name="Aprobar"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Approve" targetRef="End_Contract"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Result" targetRef="Task_Observe" name="Observar"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Observe" targetRef="Task_Submit" name="Corregir y reenviar"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TokenYes" sourceRef="Gateway_Token" targetRef="Task_Submit" name="edit"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TokenNo" sourceRef="Gateway_Token" targetRef="End_LinkUnavailable" name="otro modo"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ficha_temporal_revision">
    <bpmndi:BPMNPlane id="Plane_ficha_temporal_revision" bpmnElement="Process_personal_ficha_temporal_revision">
      <bpmndi:BPMNShape id="Lane_RRHH_di" bpmnElement="Lane_RRHH" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1850" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Worker_di" bpmnElement="Lane_Worker" isHorizontal="true">
        <dc:Bounds x="60" y="370" width="1850" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="670" width="1850" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Create_di" bpmnElement="Start_Create">
        <dc:Bounds x="215" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Link_di" bpmnElement="Task_Link">
        <dc:Bounds x="405" y="724" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="785" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="975" y="724" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="1165" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Result_di" bpmnElement="Gateway_Result">
        <dc:Bounds x="1355" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Observe_di" bpmnElement="Task_Observe">
        <dc:Bounds x="1545" y="724" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="1545" y="844" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Contract_di" bpmnElement="End_Contract">
        <dc:Bounds x="1735" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Token_di" bpmnElement="Gateway_Token">
        <dc:Bounds x="595" y="735" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LinkUnavailable_di" bpmnElement="End_LinkUnavailable">
        <dc:Bounds x="785" y="562" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="460" />
        <di:waypoint x="328" y="460" />
        <di:waypoint x="328" y="760" />
        <di:waypoint x="405" y="760" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="760" />
        <di:waypoint x="575" y="760" />
        <di:waypoint x="575" y="760" />
        <di:waypoint x="595" y="760" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="935" y="460" />
        <di:waypoint x="955" y="460" />
        <di:waypoint x="955" y="760" />
        <di:waypoint x="975" y="760" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1125" y="760" />
        <di:waypoint x="1145" y="760" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1315" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1335" y="160" />
        <di:waypoint x="1355" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1405" y="160" />
        <di:waypoint x="1475" y="160" />
        <di:waypoint x="1475" y="880" />
        <di:waypoint x="1545" y="880" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1695" y="880" />
        <di:waypoint x="1715" y="880" />
        <di:waypoint x="1715" y="160" />
        <di:waypoint x="1735" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1405" y="160" />
        <di:waypoint x="1475" y="160" />
        <di:waypoint x="1475" y="760" />
        <di:waypoint x="1545" y="760" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1695" y="760" />
        <di:waypoint x="1240" y="760" />
        <di:waypoint x="1240" y="460" />
        <di:waypoint x="785" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TokenYes_di" bpmnElement="Flow_TokenYes">
        <di:waypoint x="645" y="760" />
        <di:waypoint x="715" y="760" />
        <di:waypoint x="715" y="460" />
        <di:waypoint x="785" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TokenNo_di" bpmnElement="Flow_TokenNo">
        <di:waypoint x="645" y="760" />
        <di:waypoint x="715" y="760" />
        <di:waypoint x="715" y="580" />
        <di:waypoint x="785" y="580" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
