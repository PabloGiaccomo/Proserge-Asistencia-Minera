<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_gestionar_falta" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_asistencia_faltas_gestionar_falta" name="Corregir, justificar o anular falta" isExecutable="false">
    <bpmn:documentation>Revisa una falta originada por asistencia y actualiza o corrige el registro relacionado con trazabilidad. | Evidencia: app/Modules/Faltas/Services/FaltasService.php; app/Modules/Faltas/Services/CorregirFaltaService.php; app/Modules/Faltas/Policies/FaltasPolicy.php; tests/Feature/FaltasApiTest.php; tests/Feature/AsistenciaFaltasWebTest.php | Por confirmar: Catalogo definitivo de justificaciones y evidencia obligatoria.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_gestionar_falta">
    <bpmn:lane id="Lane_User" name="Usuario autorizado">
      <bpmn:flowNodeRef>Start_Absence</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Action</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Resolved</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Permission</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Annul</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Absence" name="Falta registrada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Review" name="Revisar falta y asistencia origen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_Permission" name="Validar permiso y relacion">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Action" name="Accion">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Correct" name="Corregir asistencia/falta">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Annul" name="Anular con motivo">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Resolved" name="Falta resuelta con trazabilidad">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Absence" targetRef="Task_Review"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Review" targetRef="Task_Permission"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Permission" targetRef="Gateway_Action"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Action" targetRef="Task_Correct" name="Corregir/justificar"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Action" targetRef="Task_Annul" name="Anular"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Correct" targetRef="End_Resolved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Annul" targetRef="End_Resolved"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_gestionar_falta">
    <bpmndi:BPMNPlane id="Plane_gestionar_falta" bpmnElement="Process_asistencia_faltas_gestionar_falta">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1310" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="370" width="1310" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Absence_di" bpmnElement="Start_Absence">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Permission_di" bpmnElement="Task_Permission">
        <dc:Bounds x="595" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Action_di" bpmnElement="Gateway_Action">
        <dc:Bounds x="785" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Correct_di" bpmnElement="Task_Correct">
        <dc:Bounds x="975" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Annul_di" bpmnElement="Task_Annul">
        <dc:Bounds x="975" y="544" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Resolved_di" bpmnElement="End_Resolved">
        <dc:Bounds x="1165" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="460" />
        <di:waypoint x="595" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="745" y="460" />
        <di:waypoint x="765" y="460" />
        <di:waypoint x="765" y="160" />
        <di:waypoint x="785" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="835" y="160" />
        <di:waypoint x="905" y="160" />
        <di:waypoint x="905" y="460" />
        <di:waypoint x="975" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="835" y="160" />
        <di:waypoint x="905" y="160" />
        <di:waypoint x="905" y="580" />
        <di:waypoint x="975" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1125" y="460" />
        <di:waypoint x="1145" y="460" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1125" y="580" />
        <di:waypoint x="1145" y="580" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1165" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
