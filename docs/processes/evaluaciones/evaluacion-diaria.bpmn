<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_evaluacion_diaria" targetNamespace="https://proserge.com/bpmn">
  <bpmn:process id="Process_evaluaciones_evaluacion_diaria" name="Evaluacion diaria desde asistencia" isExecutable="false">
    <bpmn:documentation>Solo evalua detalles cerrados PRESENTE/TARDANZA, evita autoevaluacion y duplicados por detalle. | Evidencia: app/Modules/Evaluaciones/Services/EvaluacionDesempenoService.php::createDaily; app/Modules/Evaluaciones/Policies/EvaluacionesPolicy.php; app/Modules/Asistencia/Services/AsistenciaCierreService.php; docs/evaluaciones.md; tests/Feature/EvaluacionesWebTest.php | Por confirmar: Bajo que condiciones una evaluacion revisada puede volver a los indicadores; que ocurre si el evaluador original ya no tiene acceso.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_evaluacion_diaria">
    <bpmn:lane id="Lane_Evaluator" name="Responsable o administrador">
      <bpmn:flowNodeRef>Start_Daily</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Invalid</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Sistema">
      <bpmn:flowNodeRef>Task_Rules</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Eligible</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ValidateScore</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_Score</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Daily" name="Asistencia cerrada">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Select" name="Seleccionar detalle evaluable">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_Rules" name="Validar permiso, actor, cierre y presencia">
      <bpmn:documentation>EvaluacionDesempenoService::createDaily: permiso evaluar_desempeno; personal_id obligatorio incluso admin; supervisor de encabezado o autor de alguna marca de la asistencia, salvo override administrativo; CERRADO; detalle ESTADOS_REAL; no autoevaluacion. Unicidad se comprueba despues dentro de transaccion.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Elegible?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Score" name="Calificar 5 criterios e incidencia">
      <bpmn:documentation>StoreEvaluacionDiariaRequest::rules: cinco enteros 1..4; descripcion obligatoria si hubo incidencia. Formulario web en EvaluacionDesempenoPageController::storeDaily.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Save" name="Guardar por detalle; actualizar promedio">
      <bpmn:documentation>EvaluacionDesempenoService::createDaily: transaccion con comprobacion duplicado; contexto y fecha desde asistencia, actor desde cuenta; total suma de criterios. refreshForTrabajador ocurre despues del commit, no es atomico con la evaluacion.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Done" name="Evaluacion diaria registrada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Denied" name="Evaluacion rechazada">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_ValidateScore" name="Validar criterios e incidencia">
      <bpmn:documentation>StoreEvaluacionDiariaRequest::rules. Rechaza nota fuera de 1..4 y descripcion faltante cuando hubo incidencia.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Score" name="Datos validos?">
      <bpmn:documentation>StoreEvaluacionDiariaRequest::rules; validacion HTTP anterior a createDaily.</bpmn:documentation>
      <bpmn:incoming>Flow_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Invalid" name="Corregir formulario; sin guardar">
      <bpmn:documentation>StoreEvaluacionDiariaRequest; fallo de validacion impide llamar al servicio.</bpmn:documentation>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Daily" targetRef="Task_Select"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Select" targetRef="Task_Rules"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Rules" targetRef="Gateway_Eligible"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Eligible" targetRef="Task_Score" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Score" targetRef="Task_ValidateScore"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Save" targetRef="End_Done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Eligible" targetRef="End_Denied" name="No"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Validate" sourceRef="Task_ValidateScore" targetRef="Gateway_Score"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid" sourceRef="Gateway_Score" targetRef="Task_Save" name="Si"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" sourceRef="Gateway_Score" targetRef="End_Invalid" name="No"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_evaluacion_diaria">
    <bpmndi:BPMNPlane id="Plane_evaluacion_diaria" bpmnElement="Process_evaluaciones_evaluacion_diaria">
      <bpmndi:BPMNShape id="Lane_Evaluator_di" bpmnElement="Lane_Evaluator" isHorizontal="true">
        <dc:Bounds x="60" y="70" width="1850" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="370" width="1850" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Daily_di" bpmnElement="Start_Daily">
        <dc:Bounds x="215" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Select_di" bpmnElement="Task_Select">
        <dc:Bounds x="405" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rules_di" bpmnElement="Task_Rules">
        <dc:Bounds x="595" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Eligible_di" bpmnElement="Gateway_Eligible">
        <dc:Bounds x="785" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Score_di" bpmnElement="Task_Score">
        <dc:Bounds x="975" y="124" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Save_di" bpmnElement="Task_Save">
        <dc:Bounds x="1545" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="1735" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Denied_di" bpmnElement="End_Denied">
        <dc:Bounds x="975" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateScore_di" bpmnElement="Task_ValidateScore">
        <dc:Bounds x="1165" y="424" width="150" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Score_di" bpmnElement="Gateway_Score">
        <dc:Bounds x="1355" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Invalid_di" bpmnElement="End_Invalid">
        <dc:Bounds x="1545" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="251" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="328" y="160" />
        <di:waypoint x="405" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="555" y="160" />
        <di:waypoint x="575" y="160" />
        <di:waypoint x="575" y="460" />
        <di:waypoint x="595" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="745" y="460" />
        <di:waypoint x="765" y="460" />
        <di:waypoint x="765" y="460" />
        <di:waypoint x="785" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="835" y="460" />
        <di:waypoint x="905" y="460" />
        <di:waypoint x="905" y="160" />
        <di:waypoint x="975" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1125" y="160" />
        <di:waypoint x="1145" y="160" />
        <di:waypoint x="1145" y="460" />
        <di:waypoint x="1165" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1695" y="460" />
        <di:waypoint x="1715" y="460" />
        <di:waypoint x="1715" y="160" />
        <di:waypoint x="1735" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="835" y="460" />
        <di:waypoint x="905" y="460" />
        <di:waypoint x="905" y="280" />
        <di:waypoint x="975" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_di" bpmnElement="Flow_Validate">
        <di:waypoint x="1315" y="460" />
        <di:waypoint x="1335" y="460" />
        <di:waypoint x="1335" y="460" />
        <di:waypoint x="1355" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="1405" y="460" />
        <di:waypoint x="1475" y="460" />
        <di:waypoint x="1475" y="460" />
        <di:waypoint x="1545" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="1405" y="460" />
        <di:waypoint x="1475" y="460" />
        <di:waypoint x="1475" y="160" />
        <di:waypoint x="1545" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
